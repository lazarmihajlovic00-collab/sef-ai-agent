# Copy to .env and fill in. Without an LLM key the app runs with rules only.
LLM_PROVIDER=                 # anthropic | gemini | empty = whichever key is set (Anthropic first)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BOOKING_MODEL=                # default: claude-haiku-5-5 / gemini-3.5-flash-lite
CHAT_MODEL=                   # default: claude-opus-5-5 / gemini-3.5-flash-lite
CHAT_EFFORT=medium            # Anthropic only

DATABASE_URL=sqlite:///./data/sef_agent.db
# DATABASE_URL=postgresql+psycopg://sef:sef@localhost:5432/sef

SEF_MODE=mock                 # mock | http
SEF_BASE_URL=https://demoefaktura.mfin.gov.rs
SEF_API_KEY=
MOCK_SEF_DIR=./data/sef_inbox
AS_OF_DATE=2026-11-19         # demo data is anchored to this date; leave empty in production

PRICE_TOLERANCE_PCT=1.0
DUPLICATE_WINDOW_DAYS=45
